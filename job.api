syntax = "v1"

type CommonResponse {
	Code    int         `json:"code"`
	Message string      `json:"message"`
	Data    interface{} `json:"data"`
	Success bool        `json:"success"`
}

type AnalyzeRequest {
	JobDescription string `json:"jobDescription"`
	Question       string `json:"question"`
}

type HistoryRequest {
	Page     int    `form:"page,optional"`
	PageSize int    `form:"pageSize,optional"`
	KeyWord  string `form:"keyword,optional"`
}

type DeleteHistoryRequest {
	Id int `path:"id"`
}

service job-api {
	@handler Analyze
	post /api/analyze (AnalyzeRequest) returns (CommonResponse)

	@handler History
	get /api/analyze/history (HistoryRequest) returns (CommonResponse)

	@handler DeleteHistory
	delete /api/analyze/history/:id (DeleteHistoryRequest) returns (CommonResponse)
}

